# Environment Configuration Example
# Copy this file to .env and update with your values

# Environment (dev, st, sit, e2e)
ENV=dev

# Dev Environment
DEV_BASE_URL=https://dev.example.com
DEV_API_URL=https://api-dev.example.com

# ST Environment
ST_BASE_URL=https://st.example.com
ST_API_URL=https://api-st.example.com

# SIT Environment
SIT_BASE_URL=https://sit.example.com
SIT_API_URL=https://api-sit.example.com

# E2E Environment
E2E_BASE_URL=https://e2e.example.com
E2E_API_URL=https://api-e2e.example.com

# Test Credentials (Use secure vault in production)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=SecurePassword123!

# API Keys (Use secure vault in production)
API_KEY=your-api-key-here

# Allure Report
ALLURE_REPORT_BRANCH=gh-pages
