{
  "name": "ai-assisted-qa",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright test framework with multi-environment support",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:dev": "playwright test --config=playwright.config.ts",
    "test:st": "ENV=st playwright test",
    "test:sit": "ENV=sit playwright test",
    "test:e2e": "ENV=e2e playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --grep @ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "pretest": "npm run format:check && npm run lint",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "typescript",
    "e2e",
    "api"
  ],
  "author": "Test Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "allure-js-commons": "^3.0.3",
    "package-lock.json": "^1.0.0"
  }
}
